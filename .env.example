# Copy to .env and adjust. .env is git-ignored.

# MongoDB (Atlas local, single-node replica set)
MONGO_PORT=27017
MONGO_USER=fannet
MONGO_PASSWORD=change-me

# Redis
REDIS_PORT=6379

# Kafka (KRaft, single node). Host listener: localhost:KAFKA_PORT
KAFKA_PORT=9092

# Object storage: real AWS S3 (no local emulator, see docs/decisions/)
# Use a dedicated dev bucket and an IAM user limited to it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1
S3_BUCKET=fannet-dev-media
